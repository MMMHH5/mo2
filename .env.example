PORT=3001
DATABASE_URL="postgresql://username:password@localhost:5432/laxalab_db?schema=public"
JWT_SECRET="your_jwt_secret"
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_CALLBACK_URL="http://localhost:3001/auth/google/callback"
FRONTEND_URL="http://localhost:3000"

# Set SMTP_* to deliver verification and password-reset links by email.
# Without SMTP, development logs links to the backend console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Optional S3-compatible object storage. Leave blank for local uploads.
# Render deploys require these values (Cloudflare R2 is supported).
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
