generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  INSTRUCTOR
  COURSE_MANAGER
  FINANCE
  ADMIN
}

enum EnrollmentStatus {
  PENDING
  APPROVED
  REJECTED
  RESERVED
}

enum CourseOpeningStatus {
  DRAFT
  ANNOUNCEMENT
  OPEN
  STARTED
  ENDED
}

enum CertificateStatus {
  VALID
  REVOKED
  EXPIRED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL_LEVELS
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum CouponType {
  PERCENT
  AMOUNT
}

enum QuizQuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
}

enum ReferralStatus {
  PENDING
  SIGNED_UP
  REWARDED
  EXPIRED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(STUDENT)
  isActive     Boolean  @default(true)
  language     String   @default("en")
  emailVerifiedAt DateTime?
  twoFactorSecret String?
  twoFactorEnabled Boolean @default(false)
  metadata     Json?    // Storing extensible metadata
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  coursesTaught Course[]         @relation("InstructorCourses")
  openingsTaught CourseOpening[] @relation("OpeningInstructors")
  enrollments   Enrollment[]
  certificates  Certificate[]
  auditLogs     AuditLog[]
  applications  InstructorApplication[]
  tickets       SupportTicket[]
  sentMessages  Message[]        @relation("SentMessages")
  receivedMessages Message[]     @relation("ReceivedMessages")
  openingRequests OpeningRequest[]
  closeRequests   CloseRequest[]
  courseSuggestions CourseSuggestion[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  notifications       Notification[]
  payments            Payment[]
  wishlist            Wishlist[]
  reviews             CourseReview[]
  referralsMade       Referral[]        @relation("Referrer")
  blogPosts           BlogPost[]
  announcements       Announcement[]
  chatMemberships     ChatRoomMember[]
  chatMessages        ChatMessage[]
  directChatsAsStudent  DirectChat[]    @relation("DirectChatStudent")
  directChatsAsInstructor DirectChat[]  @relation("DirectChatInstructor")
  directMessages       DirectMessage[]
  discussionPosts      DiscussionPost[]
  discussionReplies    DiscussionReply[]
  instructorRatingsReceived InstructorRating[] @relation("InstructorRatingReceived")
  instructorRatingsGiven   InstructorRating[] @relation("InstructorRatingGiven")
  points               UserPoints?
  pointLogs            PointLog[]
  learningPathsCreated LearningPath[]
  learningSessions     LearningSession[]
  peerReviewsGiven     PeerReview[]
  announcementBoardPosts AnnouncementBoard[]
}

model Course {
  id            String   @id @default(uuid())
  titleAr       String
  titleEn       String
  excerptAr     String?
  excerptEn     String?
  descriptionAr String?
  descriptionEn String?
  categoryAr    String?
  categoryEn    String?
  level         CourseLevel @default(BEGINNER)
  language      String?
  hoursOfContent Int?
  syllabusAr    String?
  syllabusEn    String?
  durationAr    String?
  durationEn    String?
  coverImageUrl String?
  introVideoUrl String?
  videoFileUrl  String?
  certificateIssued Boolean @default(false)

  // Feature flags (shown as badges / included-items on the course page)
  quizzesIncluded        Boolean @default(false)
  projectsIncluded       Boolean @default(false)
  assignmentsIncluded    Boolean @default(false)
  liveSessionsIncluded   Boolean @default(false)
  downloadableResources  Boolean @default(false)
  lifetimeAccess         Boolean @default(false)
  communityAccess        Boolean @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  instructorId String
  instructor   User   @relation("InstructorCourses", fields: [instructorId], references: [id], onDelete: Restrict)

  openings     CourseOpening[]
  modules      Module[]
  chapters     Chapter[]
  enrollments  Enrollment[]
  liveSessions LiveSession[]
  certificates Certificate[]
  objectives   CourseObjective[]
  prerequisites CoursePrerequisite[]
  audiences    CourseAudience[]
  faqs         CourseFaq[]
  gallery      CourseImage[]
  messages     Message[]
  openingRequests OpeningRequest[]
  coupons        CouponCourse[]
  wishlist       Wishlist[]
  reviews        CourseReview[]
  quizzes        Quiz[]
  directChats    DirectChat[]
  instructorRatings InstructorRating[]
  learningPathCourses LearningPathCourse[]
  learningSessions LearningSession[]
}

model CourseOpening {
  id            String   @id @default(uuid())
  nameAr        String?
  nameEn        String?
  // Scheduling of this opening (this batch/run of the course)
  startDate     DateTime?
  endDate       DateTime?
  enrollmentDeadline DateTime?
  // Fees for this opening (each opening can have its own price/discount)
  price         Decimal  @db.Decimal(10, 2)
  priceOld      Decimal? @db.Decimal(10, 2)
  currency      String   @default("SAR")
  maxStudents   Int?
  isPublished   Boolean  @default(false)
  status        CourseOpeningStatus @default(DRAFT)
  // The announcement/banner window that shows the course before it is open for enrollment.
  announcementStartAt DateTime?
  announcementEndAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  courseId     String
  course       Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // The instructor teaching THIS opening/batch
  instructorId String
  instructor   User   @relation("OpeningInstructors", fields: [instructorId], references: [id], onDelete: Restrict)

  enrollments  Enrollment[]
  assessments  Assessment[]
  closeRequests CloseRequest[]
  tasks        CourseTask[]
  payments     Payment[]
  chatRoom     ChatRoom?
  announcements Announcement[]
  calendarEvents CalendarEvent[]
}

model CourseObjective {
  id           String   @id @default(uuid())
  objectiveAr  String
  objectiveEn  String
  orderIndex   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model CoursePrerequisite {
  id              String   @id @default(uuid())
  prerequisiteAr  String
  prerequisiteEn  String
  orderIndex      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model CourseAudience {
  id          String   @id @default(uuid())
  audienceAr  String
  audienceEn  String
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model CourseFaq {
  id          String   @id @default(uuid())
  questionAr  String
  questionEn  String
  answerAr    String
  answerEn    String
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model CourseImage {
  id          String   @id @default(uuid())
  url         String
  altAr       String?
  altEn       String?
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Chapter {
  id         String   @id @default(uuid())
  titleAr    String
  titleEn    String
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  modules Module[]
}

model Module {
  id            String   @id @default(uuid())
  titleAr       String
  titleEn       String
  descriptionAr String?
  descriptionEn String?
  videoUrl      String?
  orderIndex    Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // When true this lesson is available as a free preview to un-enrolled guests.
  isFree          Boolean @default(false)
  // Approximate lesson length in minutes, shown in the syllabus/player.
  durationMinutes Int?

  // Lecture materials (files + links shown inside the lecture, independent of tasks)
  files Json? // Array of { url: string; nameAr?: string; nameEn?: string }
  links Json? // Array of { url: string; labelAr?: string; labelEn?: string }

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // Optional grouping: a lesson belongs to a chapter of the course syllabus.
  chapterId String?
  chapter   Chapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  outcomes LearningOutcome[]
  progress LessonProgress[]
  quizzes  Quiz[]
  tasks    CourseTask[]
  lessonNotes LessonNote[]
  discussions DiscussionPost[]
  learningSessions LearningSession[]
}

model LearningOutcome {
  id             String   @id @default(uuid())
  descriptionAr  String
  descriptionEn  String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
}

model Enrollment {
  id                   String           @id @default(uuid())
  status               EnrollmentStatus @default(PENDING)
  receiptFileUrl       String?
  financeOfficerNotes  String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  studentId String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Restrict)

  // The course being enrolled (one record per student per course).
  courseId  String
  course    Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  // The opening/batch the student joined (null when it was only a seat reservation
  // on a course that is not open yet).
  openingId String?
  opening   CourseOpening? @relation(fields: [openingId], references: [id], onDelete: SetNull)

grades      Grade[]
  submissions TaskSubmission[]
  payments    Payment[]
  lessonProgress LessonProgress[]
  lessonNotes    LessonNote[]
  quizAttempts   QuizAttempt[]

  // A student can only enroll in a specific course once (or have one active record)
  @@unique([studentId, courseId])
}

model LiveSession {
  id             String   @id @default(uuid())
  title          String
  scheduledAt    DateTime
  meetLink       String?
  googleMeetData Json?    // Storing Google Meet API metadata
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Certificate {
  id                 String            @id @default(uuid())
  verificationCode   String            @unique @default(uuid())
  issuingDate        DateTime          @default(now())
  verificationStatus CertificateStatus @default(VALID)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  studentId String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Restrict)

  // A certificate can optionally be tied to a specific course
  courseId  String?
  course    Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  ipAddress String?
  timestamp DateTime @default(now())

  // Note: we can keep userId optional or required. We make it optional in case of anonymous actions (e.g. brute force attempts logging)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model InstructorApplication {
  id             String            @id @default(uuid())
  name           String
  bio            String            @db.Text
  specialty      String
  cvFileUrl      String
  videoIntroUrl  String?
  status         ApplicationStatus @default(PENDING)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PaymentGateway {
  id                  String   @id @default(uuid())
  name                String   @unique
  instructions        String   @db.Text
  walletGuideImageUrl String?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model SupportTicket {
  id        String       @id @default(uuid())
  subject   String
  message   String       @db.Text
  status    TicketStatus @default(OPEN)
  adminNotes String?     @db.Text
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Assessment {
  id         String   @id @default(uuid())
  nameAr     String
  nameEn     String
  maxScore   Int      @default(100)
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  openingId String
  opening   CourseOpening @relation(fields: [openingId], references: [id], onDelete: Cascade)

  grades    Grade[]
}

model Grade {
  id           String   @id @default(uuid())
  score        Float
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, assessmentId])
}

model Message {
  id          String    @id @default(uuid())
  content     String    @db.Text
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  senderId    String
  sender      User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  recipientId String
  recipient   User      @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)

  // Optional course scope: keeps a student↔instructor thread tied to a specific course
  courseId    String?
  course      Course?   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([recipientId])
  @@index([courseId])
}

// ===== Group chat rooms (one per course opening/batch) =====
// Membership is mirrored from enrollments (approved/reserved students)
// plus the opening's instructor and platform admins.

model ChatRoom {
  id        String   @id @default(uuid())
  nameAr    String?
  nameEn    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  openingId String        @unique
  opening   CourseOpening @relation(fields: [openingId], references: [id], onDelete: Cascade)

  members  ChatRoomMember[]
  messages ChatMessage[]

  @@index([openingId])
}

model ChatRoomMember {
  id         String   @id @default(uuid())
  role       String   @default("STUDENT")
  lastReadAt DateTime?
  joinedAt   DateTime @default(now())

  roomId String
  room   ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
}

model ChatMessage {
  id             String   @id @default(uuid())
  content        String?  @db.Text
  attachmentUrl  String?
  attachmentType String?
  createdAt      DateTime @default(now())

  roomId String
  room   ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  senderId String
  sender   User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([senderId])
}

// ===== Direct (1:1) student <-> instructor chat with admin/Course-Manager oversight =====
// A conversation is scoped to one course between a student and the instructor teaching
// the opening the student is enrolled in. Admins/Course Managers can read, intervene
// and archive any conversation through the oversight panel.

model DirectChat {
  id                   String    @id @default(uuid())
  archivedAt           DateTime?
  studentLastReadAt    DateTime?
  instructorLastReadAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  studentId String
  student   User    @relation("DirectChatStudent", fields: [studentId], references: [id], onDelete: Cascade)

  instructorId String
  instructor   User    @relation("DirectChatInstructor", fields: [instructorId], references: [id], onDelete: Cascade)

  messages DirectMessage[]

  @@unique([courseId, studentId, instructorId])
  @@index([studentId])
  @@index([instructorId])
}

model DirectMessage {
  id             String   @id @default(uuid())
  content        String?  @db.Text
  attachmentUrl  String?
  attachmentType String?
  readAt         DateTime?
  createdAt      DateTime @default(now())

  chatId String
  chat   DirectChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  senderId String
  sender   User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([chatId])
  @@index([senderId])
}

// ===== Instructor Request-based workflow =====

// Instructor asks to open a new opening (batch) for a course; admin/course-manager approves.
model OpeningRequest {
  id         String            @id @default(uuid())
  courseId   String
  course     Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instructorId String
  instructor User              @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  reason     String?
  status     ApplicationStatus @default(PENDING)
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([instructorId])
  @@index([courseId])
  @@index([status])
}

// Instructor asks to end/close an opening assigned to them; admin/course-manager approves -> ENDED + certificates.
model CloseRequest {
  id         String            @id @default(uuid())
  openingId  String
  opening    CourseOpening     @relation(fields: [openingId], references: [id], onDelete: Cascade)
  instructorId String
  instructor User              @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  reason     String?
  status     ApplicationStatus @default(PENDING)
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([instructorId])
  @@index([openingId])
  @@index([status])
}

// Instructor suggests creating a brand-new course; admin/course-manager approves -> creates the Course.
model CourseSuggestion {
  id         String            @id @default(uuid())
  titleAr    String
  titleEn    String
  categoryAr String?
  categoryEn String?
  description String?
  instructorId String
  instructor User              @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  status     ApplicationStatus @default(PENDING)
  reviewNotes String?
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([instructorId])
  @@index([status])
}

// A task/assignment created by the instructor (or staff) for an opening.
model CourseTask {
  id        String    @id @default(uuid())
  titleAr   String
  titleEn   String
  descriptionAr String?
  descriptionEn String?
  dueDate   DateTime?
  maxScore  Int       @default(100)
  attachmentUrl  String?
  attachmentType String?
  links          Json? // Array of { url: string; labelAr?: string; labelEn?: string }
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  openingId String
  opening   CourseOpening @relation(fields: [openingId], references: [id], onDelete: Cascade)

  // Optional grouping: assign this task to a specific lecture (module) of the course
  moduleId String?
  module   Module? @relation(fields: [moduleId], references: [id], onDelete: SetNull)

  submissions TaskSubmission[]
  rubric     Rubric?

  @@index([openingId])
  @@index([moduleId])
}

// A student's submission for a task (one per enrollment per task).
model TaskSubmission {
  id            String    @id @default(uuid())
  content       String?
  attachmentUrl String?
  score         Float?
  notes         String?
  submittedAt   DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  taskId       String
  task         CourseTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  peerReviews PeerReview[]

  @@unique([taskId, enrollmentId])
  @@index([enrollmentId])
}

// ===== Security & account lifecycle =====

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ===== Notifications =====

model Notification {
  id        String   @id @default(uuid())
  type      String
  titleAr   String
  titleEn   String
  bodyAr    String?
  bodyEn    String?
  data      Json?
  readAt    DateTime?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, readAt])
}

// ===== Commerce: currencies, payments, coupons =====

model Currency {
  code   String  @id
  symbol String
  nameAr String
  nameEn String
  rate   Decimal @db.Decimal(10, 6)
  isBase Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id          String        @id @default(uuid())
  amount      Decimal       @db.Decimal(10, 2)
  currency    String        @default("SAR")
  status      PaymentStatus @default(PENDING)
  provider    String        @default("MANUAL")
  providerRef String?
  method      String?
  description String?
  couponCode  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  paidAt      DateTime?
  refundedAt  DateTime?

  studentId String
  student   User           @relation(fields: [studentId], references: [id], onDelete: Restrict)
  openingId String
  opening   CourseOpening  @relation(fields: [openingId], references: [id], onDelete: Restrict)
  enrollmentId String?
  enrollment   Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([openingId])
  @@index([status])
}

model Coupon {
  id        String     @id @default(uuid())
  code      String     @unique
  type      CouponType @default(PERCENT)
  value     Decimal    @db.Decimal(10, 2)
  maxUses   Int?
  usedCount Int        @default(0)
  active    Boolean    @default(true)
  startsAt  DateTime?
  expiresAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  courses CouponCourse[]
  referrals Referral[]

  @@index([active])
}

model CouponCourse {
  couponId String
  courseId String
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([couponId, courseId])
}

model Referral {
  id             String         @id @default(uuid())
  code           String         @unique
  referrerId     String
  referrer       User           @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredEmail  String?
  referredUserId String?
  status         ReferralStatus @default(PENDING)
  rewardCouponId String?
  rewardCoupon   Coupon?        @relation(fields: [rewardCouponId], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([referrerId])
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  courseId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

// ===== LMS: progress, quizzes, reviews =====

model LessonProgress {
  id           String   @id @default(uuid())
  completedAt  DateTime @default(now())

  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  moduleId     String
  module       Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, moduleId])
}

// A student's private per-lesson notes, auto-saved from the player UI.
model LessonNote {
  id        String   @id @default(uuid())
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  moduleId     String
  module       Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, moduleId])
}

model Quiz {
  id            String   @id @default(uuid())
  titleAr       String
  titleEn       String
  descriptionAr String?
  descriptionEn String?
  passScore     Int      @default(60)
  isPublished   Boolean  @default(true)
  orderIndex    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  moduleId String?
  module   Module? @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([courseId])
}

model QuizQuestion {
  id            String           @id @default(uuid())
  type          QuizQuestionType @default(SINGLE_CHOICE)
  textAr        String
  textEn        String
  options       Json
  correctIndex  Int?
  explanationAr String?
  explanationEn String?
  orderIndex    Int              @default(0)

  quizId String
  quiz   Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id          String   @id @default(uuid())
  score       Int
  passed      Boolean
  answers     Json
  submittedAt DateTime @default(now())

  quizId       String
  quiz         Quiz       @relation(fields: [quizId], references: [id], onDelete: Cascade)
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([quizId, enrollmentId])
}

model CourseReview {
  id          String   @id @default(uuid())
  rating      Int
  commentAr   String?
  commentEn   String?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
}

// ===== Content & marketing =====

model BlogPost {
  id            String   @id @default(uuid())
  slug          String   @unique
  titleAr       String
  titleEn       String
  excerptAr     String?
  excerptEn     String?
  contentAr     String   @db.Text
  contentEn     String   @db.Text
  coverImageUrl String?
  isPublished   Boolean  @default(false)
  publishedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([isPublished, publishedAt])
}

// ===== Announcements =====

model Announcement {
  id          String   @id @default(uuid())
  titleAr     String
  titleEn     String
  contentAr   String   @db.Text
  contentEn   String   @db.Text
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  openingId String
  opening   CourseOpening @relation(fields: [openingId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([openingId, isPublished, createdAt])
}

// ===== Discussions =====

model DiscussionPost {
  id          String   @id @default(uuid())
  titleAr     String
  titleEn     String
  bodyAr      String   @db.Text
  bodyEn      String   @db.Text
  isResolved  Boolean  @default(false)
  isPinned    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  replies DiscussionReply[]

  @@index([moduleId, createdAt])
}

model DiscussionReply {
  id        String   @id @default(uuid())
  bodyAr    String   @db.Text
  bodyEn    String   @db.Text
  isAnswer  Boolean  @default(false)
  createdAt DateTime @default(now())

  postId String
  post   DiscussionPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

// ===== Instructor Rating =====

model InstructorRating {
  id        String   @id @default(uuid())
  rating    Int
  commentAr String?  @db.Text
  commentEn String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  instructorId String
  instructor   User   @relation("InstructorRatingReceived", fields: [instructorId], references: [id], onDelete: Cascade)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("InstructorRatingGiven", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@index([instructorId])
}

// ===== Gamification =====

model UserPoints {
  id        String   @id @default(uuid())
  points    Int      @default(0)
  level     Int      @default(1)
  streak    Int      @default(0)
  lastActiveDate DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  badges UserBadge[]
}

model UserBadge {
  id        String   @id @default(uuid())
  badgeType String
  earnedAt  DateTime @default(now())

  pointsId String
  points   UserPoints @relation(fields: [pointsId], references: [id], onDelete: Cascade)

  @@unique([pointsId, badgeType])
}

model PointLog {
  id        String   @id @default(uuid())
  action    String
  points    Int
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ===== Learning Paths =====

model LearningPath {
  id          String   @id @default(uuid())
  titleAr     String
  titleEn     String
  descriptionAr String? @db.Text
  descriptionEn String? @db.Text
  coverImageUrl String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creatorId String
  creator   User   @relation(fields: [creatorId], references: [id], onDelete: Restrict)

  courses LearningPathCourse[]

  @@index([isPublished])
}

model LearningPathCourse {
  id        String   @id @default(uuid())
  orderIndex Int     @default(0)
  createdAt DateTime @default(now())

  pathId   String
  path     LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([pathId, courseId])
}

// ===== Calendar Events =====

model CalendarEvent {
  id          String   @id @default(uuid())
  titleAr     String
  titleEn     String
  descriptionAr String? @db.Text
  descriptionEn String? @db.Text
  startsAt    DateTime
  endsAt      DateTime
  eventType   String   @default("deadline")
  createdAt   DateTime @default(now())

  openingId String?
  opening   CourseOpening? @relation(fields: [openingId], references: [id], onDelete: Cascade)

  @@index([openingId, startsAt])
}

// ===== Rubrics & Peer Review =====

model Rubric {
  id          String   @id @default(uuid())
  titleAr     String
  titleEn     String
  createdAt   DateTime @default(now())

  taskId String
  task   CourseTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  criteria RubricCriterion[]
  reviews  PeerReview[]

  @@unique([taskId])
}

model RubricCriterion {
  id          String   @id @default(uuid())
  titleAr     String
  titleEn     String
  descriptionAr String? @db.Text
  descriptionEn String? @db.Text
  maxScore    Int      @default(10)
  orderIndex  Int      @default(0)

  rubricId String
  rubric   Rubric @relation(fields: [rubricId], references: [id], onDelete: Cascade)

  scores PeerCriterionScore[]
}

model PeerReview {
  id        String   @id @default(uuid())
  score     Int?
  commentAr String?  @db.Text
  commentEn String?  @db.Text
  status    String   @default("pending")
  createdAt DateTime @default(now())

  rubricId String
  rubric   Rubric @relation(fields: [rubricId], references: [id], onDelete: Cascade)

  submissionId String
  submission   TaskSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  reviewerId String
  reviewer   User   @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  criterionScores PeerCriterionScore[]

  @@unique([rubricId, submissionId, reviewerId])
}

model PeerCriterionScore {
  id        String   @id @default(uuid())
  score     Int
  commentAr String?
  commentEn String?

  reviewId    String
  review      PeerReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  criterionId String
  criterion   RubricCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([reviewId, criterionId])
}

// ===== Learning Analytics =====

model LearningSession {
  id          String   @id @default(uuid())
  durationSec Int      @default(0)
  startedAt   DateTime @default(now())
  lastHeartbeat DateTime @default(now())

  userId     String
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course     Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  moduleId   String?
  module     Module? @relation(fields: [moduleId], references: [id], onDelete: SetNull)

  @@index([userId, courseId, startedAt])
}

// ===== Announcement Board (Dashboard + Homepage banners) =====

model AnnouncementBoard {
  id              String   @id @default(uuid())
  titleAr         String
  titleEn         String
  bodyAr          String?  @db.Text
  bodyEn          String?  @db.Text
  mediaType       String   @default("none") // none | image | video
  mediaUrl        String?
  linkUrl         String?
  priority        Int      @default(0)
  isActive        Boolean  @default(true)
  durationSeconds Int      @default(5) // seconds to display before auto-rotate
  startsAt        DateTime?
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([isActive, priority, startsAt, expiresAt])
}
